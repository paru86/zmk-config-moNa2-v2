#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

/* DYA Studio から作成したマクロを呼び出す `&rmacro <slot>` を定義する。
   slot は 0 〜 CONFIG_ZMK_RUNTIME_MACRO_COUNT-1 (現状 0〜7)。
   どのマクロがどのスロットに入っているかは DYA Studio のマクロ一覧で確認する。
   キーへの割り当ては DYA Studio のキーマップエディタからも行える。 */

#include <behaviors/runtime_macro.dtsi>

/* デフォルトレイヤー変更 behavior `&df`。
   DYA Studio の「OSごとのデフォルトレイヤー」から設定できるほか、
   キーマップエディタで `&df DF_SEL <layer>` / `&df DF_INC` を
   任意のキーに割り当てられる。 */

#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    /* ─────────────────────────────────────────────────────────────
       コンボ (DYA Studio から編集可能)

       旧 `combos { compatible = "zmk,combos"; }` はコンパイル時固定で
       DYA Studio から編集できないため、zmk-feature-runtime-combo の
       「コンパイル時デフォルト」ノードへ移行した。
       ここに書いた内容はフラッシュ直後から有効で、設定を消しても復活する。
       DYA Studio 側で編集するとそのスロットだけ上書きされ、
       Web UI の "Reset to Default" でここの値へ戻せる。

       スロット総数は CONFIG_ZMK_RUNTIME_COMBO_MAX_COMBOS (現状 16)。
       未使用スロット (2〜15) は DYA Studio から自由に追加できる。
       ────────────────────────────────────────────────────────── */

    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        layer4_ESC {
            slot = <0>;
            display-name = "Layer4 ESC";
            key-positions = <38 39>;
            bindings = <&lt 4 ESC>;
        };

        tab {
            slot = <1>;
            display-name = "Tab";
            key-positions = <11 12>;
            bindings = <&kp TAB>;
        };
    };

    /* 静的マクロ。キーマップ上で &BT0 / &screenshot などの名前で直接
       参照しているため、そのまま残している (DYA Studio 上では編集不可)。
       DYA Studio から編集したいマクロは Web UI で新規作成し、
       キーに `&rmacro <slot>` を割り当てて使う。 */

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        BT0: BT0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT0";
        };

        BT1: BT1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT1";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダ用 runtime-configurable sensor rotate
        // デフォルトはスクロール (cw=SCRL_DOWN, ccw=SCRL_UP)
        // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
        // kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能

        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;
            bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB           &kp W         &kp E         &kp R                        &kp T                                           &kp Y          &kp U  &kp I      &kp O    &lt 2 P
&mt LCTRL A       &kp S         &kp D         &kp F                        &kp G                            &kp SQT        &kp H          &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                        &kp B             &kp EQUAL      &kp SEMICOLON  &kp N          &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&lt 6 Q           &kp LEFT_WIN  &kp LEFT_ALT  &mt LEFT_CONTROL LANGUAGE_2  &lt 5 LANGUAGE_1  &lt 4 SPACE    &lt 3 ENTER    &kp BACKSPACE                             &kp DEL
            >;

            sensor-bindings = <&rsr_default>, <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        mouse_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &mkp MCLK  &mkp LCLK  &mkp RCLK
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &mkp MB4   &mkp MB5   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        scroll_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        num_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                             &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none       &kp SLASH
&trans  &trans  &trans  &trans  &trans            &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none       &kp ASTRK
&trans  &trans  &trans  &trans  &trans  &trans    &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans    &trans           &kp KP_N0                                                      &kp PLUS
            >;

            sensor-bindings = <&rsr_default>;
        };

        symbol_4 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                    &kp CARET      &kp AMPERSAND  &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp GRAVE        &trans       &trans    &trans      &trans                 &trans  &kp BACKSLASH  &kp SEMICOLON  &kp SQT            &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&kp TILDE        &trans       &trans    &trans      &trans       &trans    &trans  &kp PIPE       &kp COLON      &kp DOUBLE_QUOTES  &kp LEFT_BRACE        &kp RIGHT_BRACE
&trans           &trans       &trans    &trans      &trans       &trans    &trans  &trans                                                                 &trans
            >;
        };

        fn_5 {
            bindings = <
&kp Q      &trans          &kp UP_ARROW    &trans     &trans                    &kp F7  &kp F8  &kp F9  &kp F12  &trans
&kp LC(A)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans            &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans     &trans          &trans          &trans     &trans  &trans    &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
&trans     &trans          &trans          &trans     &trans  &trans    &trans  &trans                           &trans
            >;
        };

        navi_6 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bt BT_CLR_ALL                        &kp INS     &kp HOME  &kp PAGE_UP    &trans  &studio_unlock
&trans        &trans        &trans        &trans      &trans                    &trans      &kp DELETE  &kp END   &kp PAGE_DOWN  &trans  &trans
&trans        &trans        &trans        &trans      &trans          &trans    &kp ESCAPE  &trans      &trans    &trans         &trans  &trans
&trans        &trans        &trans        &trans      &trans          &trans    &trans      &trans                                       &trans
            >;
        };
    };
};
